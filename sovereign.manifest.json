{
  "manifest": 2,
  "prefix": "tusk",
  "name": "Tusk",
  "description": "Your own work, private by default, and the boards you share. Runs on its own or on a Sovereign instance.",
  "port": 3000,
  "health": "/api/health",
  "launch": "/",
  "signIn": {
    "redirect": ["/auth/callback"],
    "postLogout": ["/"],
    "backChannel": "/auth/backchannel-logout",
    "accountDeleted": "/auth/account-deleted",
    "scopes": ["openid", "profile", "email", "offline_access"]
  },
  "database": { "pooling": "transaction" },
  "generate": ["TUSK_AUTH_SECRET"],
  "core": ">=0.49.0 <1.0.0"
}
