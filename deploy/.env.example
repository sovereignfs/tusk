# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every setting Tusk reads is described in the repository's own .env.example; these are the ones a deployment sets.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
TUSK_URL=http://localhost:3002
# The port on this machine that a reverse proxy sends to (the container listens on 3002, the port in sovereign.manifest.json).
# TUSK_PORT=3002

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
TUSK_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
TUSK_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
TUSK_AUTH_SIGNUP=closed

# --- Credentials at rest -------------------------------------------------------------------------------------------
# Without this, a repository cannot be connected for backup. Make it once and keep it with your secrets, apart from the database
# backups: a lost key means connecting the repositories again.   openssl rand -base64 32
TUSK_ENCRYPTION_KEY=

# --- GitHub (optional) ---------------------------------------------------------------------------------------------
# Where GitHub's API is, for a GitHub Enterprise Server: https only. Default https://api.github.com.
# TUSK_GITHUB_API_URL=

# --- PostgreSQL (compose.postgres.yaml only) ----------------------------------------------------------------------
# The database's own password.   openssl rand -hex 16
POSTGRES_PASSWORD=
