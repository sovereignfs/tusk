# What the instance gives this app (contracts/app-manifest.md §3), for running it on your own machine against a core you can reach.
# A secret may be given as NAME_FILE=/path instead of NAME=value.
TASKS_URL=http://localhost:3000
TASKS_CORE_URL=https://core.sovereign.local
TASKS_CORE_CLIENT_ID=
TASKS_CORE_CLIENT_SECRET=
TASKS_DB_DIALECT=postgres
TASKS_POSTGRES_URL=postgres://user:password@localhost:5432/tasks
# The same database on the server itself, never behind a pooler: the migrations and the token lock use it. Without it, the line above is used.
TASKS_POSTGRES_DIRECT_URL=postgres://user:password@localhost:5432/tasks
# The most connections the app may hold in all (2 or more), 2 of them for the direct address. An instance sets it, and limits the app's
# database role to that number plus 2. Without it, 10.
TASKS_POSTGRES_POOL_MAX=10
TASKS_AUTH_SECRET=change-me-to-something-long-and-random
