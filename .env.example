# Every setting Tasks reads, in one place. Copy to `.env` and edit; keep it out of version control, since it holds secrets. `deploy/` has the
# same for each way of running it. A secret may be given as NAME_FILE=/path instead of NAME=value, so that it is never in the process list.
# An instance that hosts Tasks gives it what it needs itself (contracts/app-manifest.md §3), and the rest comes from the operator.

# --- The address people use ----------------------------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
TASKS_URL=http://localhost:3000

# --- Background jobs -------------------------------------------------------------------------------------------------------------------
# Reminders, backups and clean-up run inside the web process. When several processes share one database, set `off` on all but one.
# TASKS_WORKER=on

# --- Signing in: at least one way must be on -------------------------------------------------------------------------------------------
# Email and password, passkeys and two-factor.
TASKS_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
TASKS_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. A Sovereign instance that hosts Tasks sets `open`.
TASKS_AUTH_SIGNUP=closed
# The shortest password, 8 to 128. Default 10.
# TASKS_AUTH_PASSWORD_MIN_LENGTH=10

# Sovereign sign-in (optional; all three together). TASKS_CORE_URL is the instance's core, its address with no path.
# TASKS_CORE_URL=https://sovereign.example.com
# TASKS_CORE_CLIENT_ID=
# TASKS_CORE_CLIENT_SECRET=

# --- Database: one of three forms --------------------------------------------------------------------------------------------------------
# `sqld` (the default), `sqlite` or `postgres`. Nothing guesses it from an address.
# TASKS_DB_DIALECT=sqld
# sqld: the service, and the address that makes its namespaces.
# TASKS_SQLD_URL=http://sqld:8080
# TASKS_SQLD_ADMIN_URL=http://sqld:8081
# sqlite: a file, for one container. Never on a network filesystem.
# TASKS_SQLITE_URL=file:/data/tasks.db
# postgres: the address, a root certificate for TLS, and the most connections the app may hold (2 or more).
# TASKS_POSTGRES_URL=postgres://user:password@localhost:5432/tasks
# PGSSLROOTCERT=
# TASKS_POSTGRES_POOL_MAX=10
# How long to wait for a database that is still starting, in milliseconds. Default 30000.
# TASKS_DB_CONNECT_TIMEOUT_MS=30000
# Where the migrations are, if not beside the server.
# TASKS_MIGRATIONS_DIR=

# --- Credentials at rest ---------------------------------------------------------------------------------------------------------------
# Without this, a repository cannot be connected for backup. Make it once and keep it with your secrets, apart from the database backups:
# a lost key means connecting the repositories again.   openssl rand -base64 32
TASKS_ENCRYPTION_KEY=
# When changing the key, put the old one here until the server has started once with both.
# TASKS_ENCRYPTION_KEY_PREVIOUS=

# --- Operator-key encryption (optional) --------------------------------------------------------------------------------------------------
# `on` makes the server encrypt the content of tasks with TASKS_ENCRYPTION_KEY. The operator can still read them, and people are not offered
# a key of their own. It never converts data silently: the server stops if this disagrees with what is stored. Off by default.
# TASKS_DB_ENCRYPTION=off

# --- Web Push (optional): all three, or none ---------------------------------------------------------------------------------------------
# npx web-push generate-vapid-keys
# TASKS_VAPID_PUBLIC_KEY=
# TASKS_VAPID_PRIVATE_KEY=
# A mailto: or https: address that identifies you to the push services.
# TASKS_VAPID_SUBJECT=mailto:admin@example.com

# --- Email (optional): verification, password reset and reminders ------------------------------------------------------------------------
# TASKS_SMTP_HOST=
# TASKS_SMTP_PORT=587
# TASKS_SMTP_USER=
# TASKS_SMTP_PASSWORD=
# TASKS_SMTP_FROM=Tasks <tasks@example.com>

# --- Backup to GitHub (optional) ---------------------------------------------------------------------------------------------------------
# The GitHub App lets people connect a repository without handling a token. All of these, or none.
# TASKS_GITHUB_APP_ID=
# TASKS_GITHUB_APP_SLUG=
# TASKS_GITHUB_APP_CLIENT_ID=
# TASKS_GITHUB_APP_CLIENT_SECRET=
# TASKS_GITHUB_APP_WEBHOOK_SECRET=
# The .pem GitHub gave, as a file (recommended):
# TASKS_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Where GitHub's API is, when it is not github.com's (an Enterprise Server's https://host/api/v3). Tokens are sent there, so https.
# TASKS_GITHUB_API_URL=
