# Every setting Tusk reads, in one place. Copy to `.env` and edit; keep it out of version control, since it holds secrets. `deploy/` has the
# same for each way of running it. A secret may be given as NAME_FILE=/path instead of NAME=value, so that it is never in the process list.
# An instance that hosts Tusk gives it what it needs itself (contracts/app-manifest.md §3), and the rest comes from the operator.

# --- The address people use ----------------------------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
TUSK_URL=http://localhost:3000

# --- Background jobs -------------------------------------------------------------------------------------------------------------------
# Reminders, backups and clean-up run inside the web process. When several processes share one database, set `off` on all but one.
# TUSK_WORKER=on

# --- Signing in: at least one way must be on -------------------------------------------------------------------------------------------
# Email and password, passkeys and two-factor.
TUSK_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
TUSK_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. A Sovereign instance that hosts Tusk sets `open`.
TUSK_AUTH_SIGNUP=closed
# The shortest password, 8 to 128. Default 10.
# TUSK_AUTH_PASSWORD_MIN_LENGTH=10

# Sovereign sign-in (optional; all three together, and either way of signing in, or both, can be on). TUSK_CORE_URL is the instance's core, its OIDC issuer:
# its address with no path and no trailing slash, https (http for localhost). Register the client at core with the redirect address
# <TUSK_URL>/api/auth/callback/sovereign. Needs TUSK_URL and TUSK_AUTH_SECRET as local sign-in does; TUSK_AUTH_LOCAL may then be 0.
# TUSK_CORE_URL=https://sovereign.example.com
# TUSK_CORE_CLIENT_ID=
# TUSK_CORE_CLIENT_SECRET=

# --- Database: one of three forms --------------------------------------------------------------------------------------------------------
# `sqld` (the default), `sqlite` or `postgres`. Nothing guesses it from an address.
# TUSK_DB_DIALECT=sqld
# sqld: the service, and the address that makes its namespaces.
# TUSK_SQLD_URL=http://sqld:8080
# TUSK_SQLD_ADMIN_URL=http://sqld:8081
# sqlite: a file, for one container. Never on a network filesystem.
# TUSK_SQLITE_URL=file:/data/tusk.db
# postgres: the address, a root certificate for TLS, and the most connections the app may hold (2 or more).
# TUSK_POSTGRES_URL=postgres://user:password@localhost:5432/tusk
# PGSSLROOTCERT=
# TUSK_POSTGRES_POOL_MAX=10
# How long to wait for a database that is still starting, in milliseconds. Default 30000.
# TUSK_DB_CONNECT_TIMEOUT_MS=30000
# Where the migrations are, if not beside the server.
# TUSK_MIGRATIONS_DIR=

# --- Credentials at rest ---------------------------------------------------------------------------------------------------------------
# Without this, a repository cannot be connected for backup. Make it once and keep it with your secrets, apart from the database backups:
# a lost key means connecting the repositories again.   openssl rand -base64 32
TUSK_ENCRYPTION_KEY=
# When changing the key, put the old one here until the server has started once with both.
# TUSK_ENCRYPTION_KEY_PREVIOUS=

# --- GitHub (optional) ---------------------------------------------------------------------------------------------------------------------
# Where GitHub's API is, for a GitHub Enterprise Server. https, or http for localhost alone. Default https://api.github.com.
# TUSK_GITHUB_API_URL=https://api.github.com

# --- Operator-key encryption: NOT AVAILABLE YET ---------------------------------------------------------------------------------------
# `on` would make the server encrypt the content of the Desk and of every workspace with TUSK_ENCRYPTION_KEY (the operator could still read it, and
# personal keys would not be offered). It is not built (task 14.7), and the server refuses to start with it `on`, rather than say it encrypts when it does
# not. Leave it off: a person can seal their own Desk with a key of their own (Settings, Data).
# TUSK_DB_ENCRYPTION=off

# --- Web Push (optional): all three, or none ---------------------------------------------------------------------------------------------
# npx web-push generate-vapid-keys
# TUSK_VAPID_PUBLIC_KEY=
# TUSK_VAPID_PRIVATE_KEY=
# A mailto: or https: address that identifies you to the push services.
# TUSK_VAPID_SUBJECT=mailto:admin@example.com

# --- Email (optional): verification, password reset and reminders ------------------------------------------------------------------------
# With a host, an address is confirmed by a link before its first sign-in, and a forgotten password is reset by a link. Without one, neither exists.
# TUSK_SMTP_HOST=
# TUSK_SMTP_PORT=587
# TUSK_SMTP_USER=
# TUSK_SMTP_PASSWORD=
# TUSK_SMTP_FROM=Tusk <tusk@example.com>

# --- Backup to GitHub (optional) ---------------------------------------------------------------------------------------------------------
# The GitHub App lets people connect a repository without handling a token. All of these, or none.
# TUSK_GITHUB_APP_ID=
# TUSK_GITHUB_APP_SLUG=
# TUSK_GITHUB_APP_CLIENT_ID=
# TUSK_GITHUB_APP_CLIENT_SECRET=
# TUSK_GITHUB_APP_WEBHOOK_SECRET=
# The .pem GitHub gave, as a file (recommended):
# TUSK_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Where GitHub's API is, when it is not github.com's (an Enterprise Server's https://host/api/v3). Tokens are sent there, so https.
# TUSK_GITHUB_API_URL=
